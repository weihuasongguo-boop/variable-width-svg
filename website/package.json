{
  "name": "variable-width-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 4200",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "npm run typecheck && react-router build && node scripts/finish.mjs",
    "preview": "wrangler dev --port 4201",
    "deploy": "wrangler deploy",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@phosphor-icons/react": "2.1.10",
    "isbot": "5.2.2",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "version": "0.1.0"
}
